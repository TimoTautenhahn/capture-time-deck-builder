# Copy to .env and fill in. No secrets are committed to this repo.
# The Google OAuth client secret is NOT an env var: place the OAuth
# desktop-client JSON at auth-hub/credentials.json (gitignored).

# --- Local auth broker (auth-hub/server.py) ---
AUTH_HUB_BASE=http://127.0.0.1:8790
AUTH_HUB_PORT=8790

# --- Web control surface (webapp/app.py) ---
WEBAPP_PORT=8788
AUTH_TARGET_APP=presentationPublisher
# Hosted broker base URL, if you run the broker remotely instead of locally.
BROKER_BASE=
# Google Drive folder id that holds the source media (optional default).
DEFAULT_FOLDER_ID=
# Reuse/rebuild an existing Google Slides deck instead of creating a new one.
EXISTING_PRESENTATION_ID=
# Comma-separated Drive subfolder names scanned for media.
SOURCE_FOLDERS=Album A,Album B,Album C
# Subfolder whose media is always placed first.
PRIMARY_FOLDER_NAME=Highlights

# --- Tuning (optional) ---
CHUNK_SIZE_MB=90
REQUEST_TIMEOUT_SEC=120
MAX_RETRIES_PER_ITEM=3
BATCH_REQUEST_SIZE=30
CHECKPOINT_INTERVAL=25
DEBUG_LOG_FILE=debug.log
